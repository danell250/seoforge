PORT=4000
NODE_ENV=development
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend origins allowed by CORS
FRONTEND_URL=http://localhost:5173
# Optional comma-separated allowlist for multiple frontends
# FRONTEND_URLS=http://localhost:5173,https://app.example.com

# Admin bootstrap account
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=ChangeMe123!
AUTH_BOOTSTRAP_ADMIN=false

# Database
# DATABASE_URL=postgresql://...

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_WEBHOOK_SECRET=your_paypal_webhook_secret_here

# Google Login (comma-separated supported Web Client IDs if needed)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Stitch Express
# STITCH_EXPRESS_CLIENT_ID=
# STITCH_EXPRESS_CLIENT_SECRET=
# STITCH_EXPRESS_WEBHOOK_SECRET=
# STITCH_EXPRESS_REDIRECT_URL=
