# Backend Environment Variables
PORT=4000
NODE_ENV=development
GEMINI_API_KEY=your_gemini_api_key_here
# Groq API key (optional - if set, uses Llama 3.1 70B instead of Gemini)
GROQ_API_KEY=your_groq_api_key_here

# CORS - Frontend URL (for development)
FRONTEND_URL=http://localhost:5173
# Optional comma-separated override for multiple allowed frontend origins
# FRONTEND_URLS=http://localhost:5173,https://app.example.com

# Admin login bootstrap
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=ChangeMe123!
# Set to true once when you want the server to create the bootstrap admin record
AUTH_BOOTSTRAP_ADMIN=false

# Database (if needed)
# DATABASE_URL=

# Email (if needed)
# RESEND_API_KEY=

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_WEBHOOK_SECRET=your_paypal_webhook_secret_here
